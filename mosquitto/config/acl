# ACCESS CONTROL LIST
# -------------------
# Enforced via acl_file in mosquitto.conf. A user without an entry below is
# denied every topic, so add the user here before pointing a client at the
# broker. Passwords live in mosquitto/config/passwd (see make create-password).

# ESP32 watchdog - publishes its own heartbeat, nothing else.
user esp32-watchdog
topic write watchdog/ping

# Lab consumer - reads the heartbeat, publishes the derived uptime events.
user lab-watchdog
topic read watchdog/ping
topic write events/uptime/lab
topic write events/uptime/watchdog

# MQTT Explorer web UI - read-only view of everything, plus broker stats.
# '#' does not match $SYS, so that needs its own rule.
user web-ui
topic read #
topic read $SYS/#
