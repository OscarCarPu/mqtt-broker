# Copy to .env and fill in the values. .env is gitignored - keep real
# credentials out of the repository.

# Broker address as seen from the mqtt-explorer container. Use the compose
# service name unless the UI should talk to a broker elsewhere.
MQTT_HOST=mosquitto
MQTT_PORT=1883

# Credentials the web UI connects with. The user must exist in the broker
# (make create-password) and have an entry in mosquitto/config/acl, otherwise
# every topic is denied.
MQTT_USERNAME=web-ui
MQTT_PASSWORD=
